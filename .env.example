# ===========================================================
# baileys_esam - Gateway WhatsApp con Baileys (sin Chromium)
# ===========================================================

# --- Servidor -------------------------------------------------
HOST=127.0.0.1
# Puerto del gateway compatible OpenWA (lo consume openwa_basico / cronogramas)
PORT=2785
# Puerto de la API de integracion v1 (drop-in de openwa_basico)
API_PORT=8020
# Puerto del panel web propio
PANEL_PORT=8030

# --- Seguridad ------------------------------------------------
# API key del gateway (header X-API-Key). Vacio = sin auth (solo desarrollo).
API_KEY=
# Token Bearer de la API v1 (debe coincidir con cronogramas).
INTEGRATION_TOKEN=
# IPs permitidas para la API v1.
INTEGRATION_ALLOWED_IPS=127.0.0.1,::1
# Secreto SSO (mismo valor que cronogramas).
SSO_SECRET=
# Clave de firma de la cookie de sesion del panel.
APP_KEY=baileys_esam_dev_key
SESSION_COOKIE=baileys_esam_session
SESSION_TTL_HOURS=336
# Administrador local del panel. Se crea SOLO en el primer arranque (si no hay
# ningun usuario local); cambiar estos valores despues no modifica la clave.
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_EMAIL=admin@baileys.local
LOCAL_ADMIN_PASSWORD=cambiar-esta-clave

# --- Zona horaria ---------------------------------------------
# Hora de Bolivia para el cupo diario, la ventana de envío, recordatorios y reportes.
APP_TIMEZONE=America/La_Paz

# --- Almacenamiento ------------------------------------------
DB_PATH=./data/baileys_esam.sqlite
BAILEYS_AUTH_DIR=./data/baileys
STORAGE_DIR=./data/media
LOG_LEVEL=info
# Log interno de Baileys (silent | warn | debug). Solo para diagnostico.
BAILEYS_LOG=silent

# --- Sesiones ------------------------------------------------
# Reconectar al arrancar las líneas ya vinculadas (si es false, tras un reinicio
# no se reciben mensajes hasta que alguien entra al panel).
AUTO_START_SESSIONS=true
MAX_CONCURRENT_SESSIONS=0
# Nombre de dispositivo que se ve en el telefono (Dispositivos vinculados)
BAILEYS_BROWSER_NAME=Seguimiento ESAM
# Version de WhatsApp Web (vacio = la que resuelva Baileys)
BAILEYS_WA_VERSION=
# Pedir el historial al vincular un dispositivo nuevo (necesario para ver los
# mensajes que llegaron mientras la sesion no estaba vinculada).
BAILEYS_SYNC_FULL_HISTORY=true

# --- Sincronizacion de historial -----------------------------
# Al reconectar, pedir los ultimos mensajes de los chats conocidos.
HISTORY_SYNC_ON_READY=true
# Mensajes a pedir por chat.
HISTORY_SYNC_COUNT=50
# Maximo de chats a sincronizar por cada reconexion.
HISTORY_SYNC_MAX_CHATS=50
# Solo chats con actividad en los ultimos N dias.
HISTORY_SYNC_MAX_AGE_DAYS=30
# No re-sincronizar un chat si se hizo hace menos de N horas.
HISTORY_SYNC_SKIP_FRESH_HOURS=12

# --- Anti-baneo (pacing) -------------------------------------
PACING_ENABLED=true
PACING_DELAY_MIN=25
PACING_DELAY_MAX=45
# Dias de envio ISO: 1=lunes ... 7=domingo
PACING_WINDOW_DAYS=1,2,3,4,5,6
PACING_WINDOW_START=08:00
PACING_WINDOW_END=20:00
PACING_PROGRAM_COOLDOWN_MINUTES=10

# --- Webhooks salientes --------------------------------------
WEBHOOK_TIMEOUT=10000
# Reintentos con backoff exponencial si el receptor cae.
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_BASE_MS=30000

# --- Retencion de archivos -----------------------------------
# Dias que se conservan los archivos de data/media antes de borrarlos.
MEDIA_RETENTION_DAYS=30
# Compactar la base (VACUUM) automaticamente. Bloquea el panel mientras corre;
# dejar en false salvo mantenimiento puntual.
AUTO_VACUUM=false

# --- Media diferida ------------------------------------------
# Bajar en segundo plano la media de los mensajes que llegaron con el sistema
# cerrado. La del historial se baja al abrirla en el panel.
MEDIA_DOWNLOAD_OFFLINE=true
# Segundos maximos por descarga; si WhatsApp ya no tiene el archivo se marca
# como "no disponible" y no se vuelve a intentar en cada vista.
MEDIA_DOWNLOAD_TIMEOUT=20

# --- Respaldos -----------------------------------------------
# Respaldo diario de la base y de las credenciales (data/baileys).
# Manual: npm run backup
BACKUP_ENABLED=true
BACKUP_DIR=./data/backups
# Cantidad de respaldos que se conservan (~130 MB cada uno hoy).
BACKUP_KEEP=7
# Hora local del respaldo diario (0-23).
BACKUP_HOUR=3

# --- Diagnostico ---------------------------------------------
# Vuelca cada mensaje crudo a data/debug-messages.jsonl (contiene datos
# personales y crece sin limite: activar solo para diagnosticar).
DEBUG_DUMP_MESSAGES=false

# --- Transcripcion de notas de voz (OpenAI-compatible) -------
# driver: chat (multimodal /chat/completions) | whisper (/audio/transcriptions)
# Sin TRANSCRIBE_API_KEY la transcripcion queda deshabilitada.
TRANSCRIBE_DRIVER=chat
TRANSCRIBE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=mimo-v2.5
TRANSCRIBE_LANGUAGE=es
TRANSCRIBE_TIMEOUT=90
# Instruccion opcional para el modelo (si se deja vacia, se usa la de por defecto: dejar comentada).
# TRANSCRIBE_PROMPT=Transcribe el audio en espanol de forma literal.
