# Dependencias y compilación
node_modules/
dist/

# Datos de ejecución: base, credenciales de WhatsApp, media, respaldos y logs.
# NUNCA subir: contienen conversaciones y las claves de la sesión vinculada.
data/
storage/
*.log
*.sqlite
*.sqlite-wal
*.sqlite-shm
debug-messages.jsonl

# Configuración local con secretos
.env
.env.*
!.env.example

# Plantilla Velzon (licencia comercial de Themesbrand): no se redistribuye.
