{
  "name": "baileys-esam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gateway WhatsApp con Baileys (sin Chromium): reemplazo liviano de OpenWA + motor de lotes/plantillas/anti-ban para Seguimiento ESAM",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "serve": "node scripts/run-forever.cjs",
    "restart": "node scripts/restart.cjs",
    "backup": "tsx src/cli/backup.ts",
    "check:assets": "node scripts/check-assets.cjs",
    "admin:password": "tsx src/cli/admin-password.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "opus-recorder": "^8.0.5",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
